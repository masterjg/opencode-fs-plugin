{
  "name": "opencode-fs-plugin",
  "version": "1.3.1",
  "type": "module",
  "description": "OpenCode 2 plugin: Linux-style filesystem, text, and HTTP(S) tools under the fs namespace.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masterjg/opencode-fs-plugin.git"
  },
  "homepage": "https://github.com/masterjg/opencode-fs-plugin#readme",
  "bugs": {
    "url": "https://github.com/masterjg/opencode-fs-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "skills",
    "SPEC.md",
    "INSTALL.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "diff": "^9.0.0",
    "picomatch": "^4.0.7",
    "tar-stream": "^3.2.2",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.7"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.7",
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.2",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "license": "EPL-2.0",
  "license-wizard": {
    "licenseId": "EPL-2.0",
    "headers": {
      "style": "short"
    }
  }
}
